package kashemjava;

public class KashemJava{
    public static void main(String[] args) {
        int counter = 0;
        for(int i = 1; i <= 100; i++){
            if(i % 3 == 0){
                counter++; 
            }
           }
        System.out.println("Between 1 and 100, " + counter + " numbers are divisible by 3");
        }
    }
