package kashemjava;

import java.util.Scanner;

public class KashemJava{
    public static void main(String[] args) {
        int sum = 0;
        Scanner kashem = new Scanner(System.in);
        System.out.println("Enter the value of N: ");
        int N = kashem.nextInt();
        
        for(int i = 1; i <= N; i++){
            sum += i;
            }
        System.out.println(sum);
        }
    }
