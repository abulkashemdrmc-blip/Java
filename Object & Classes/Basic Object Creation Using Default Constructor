package Taxonomy;

public class Hierarchy {
    private String name;
    private String kingdom;
    private String phylum;
    private String subPhylum;
    private String classOfHuman;
    private String order;
    private String family;
    private String genus;
    private String species;

public Hierarchy() {                  //Default Constructor
    }

public String getName() {
        return name;
    }

    public void setName(String name) {
        
        if(name.length() > 3){
            this.name = name;
        }
        else{
            this.name = "Invalid";
        }
    }

    public String getKingdom() {
        return kingdom;
    }

    public void setKingdom(String kingdom) {
        this.kingdom = kingdom;
    }

    public String getPhylum() {
        return phylum;
    }

    public void setPhylum(String phylum) {
        this.phylum = phylum;
    }

    public String getSubPhylum() {
        return subPhylum;
    }

    public void setSubPhylum(String subPhylum) {
        this.subPhylum = subPhylum;
    }

    public String getClassOfHuman() {
        return classOfHuman;
    }

    public void setClassOfHuman(String classOfHuman) {
        this.classOfHuman = classOfHuman;
    }

    public String getOrder() {
        return order;
    }

    public void setOrder(String order) {
        this.order = order;
    }

    public String getFamily() {
        return family;
    }

    public void setFamily(String family) {
        this.family = family;
    }

    public String getGenus() {
        return genus;
    }

    public void setGenus(String genus) {
        this.genus = genus;
    }

    public String getSpecies() {
        return species;
    }

    public void setSpecies(String species) {
        this.species = species;
    }
    
    public void printDetails(){
        System.out.println("Taxonomical Hierarchy of " + name + " is given below: ");
        System.out.println("Kingdom: " + kingdom);
        System.out.println("Phylum: " + phylum);
        System.out.println("Sub-Phylum: " + subPhylum);
        System.out.println("Class: " + classOfHuman);
        System.out.println("Order: " + order);
        System.out.println("Family: " + family);
        System.out.println("Genus: " + genus);
        System.out.println("Species: " + species);
   }

    public static void main(String[] args) {
     
        Hierarchy hierarchy = new Hierarchy();

        hierarchy.setName("Man");
        
        hierarchy.name = "Human";
        
        hierarchy.setKingdom("Animalia");
        hierarchy.setPhylum("Chordata");
        hierarchy.setSubPhylum("Vertebrata");
        hierarchy.setClassOfHuman("Mammalia");
        hierarchy.setOrder("Primate");
        hierarchy.setFamily("Hominidae");
        hierarchy.setGenus("Homo");
        hierarchy.setSpecies("Homo Sapiens");
        
        hierarchy.printDetails();
        
        System.out.println(hierarchy.getKingdom());
        
    }
}
