package kashemjava;

import java.util.Scanner;

public class KashemJava{
    public static void main(String[] args) {
        Scanner kashem = new Scanner(System.in);
        System.out.println("Enter your age: ");
        int number = kashem.nextInt();
        
        if (number >= 18){
            System.out.println("Congratulations! You are eligible for driving license");
        }
        else{
            System.out.println("Not eligible to get driving license");
        }
    }
}
