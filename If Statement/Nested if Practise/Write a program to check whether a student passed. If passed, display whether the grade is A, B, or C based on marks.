package kashemjava;

import java.util.Scanner;

public class KashemJava{
    public static void main(String[] args) {
        Scanner kashem = new Scanner(System.in);
        System.out.println("Enter your marks in CSE110: ");
        int marks = kashem.nextInt();
        
        if (marks > 100){
            System.out.println("Invalid Marks");
        }
        else if (marks >= 0){
            if (marks >= 80){
                System.out.println("Congratulations! You have passed. Your grade is A+");
            }
            else if(marks >= 70){
                System.out.println("Congratulations! You have passed. Your grade is A");
            }
            else if(marks >= 60){
                System.out.println("Congratulations! You have passed. Your grade is A-");
            }
            else if(marks >= 50){
                System.out.println("Congratulations! You have passed. Your grade is B");
            }
            else if(marks >= 40){
                System.out.println("Congratulations! You have passed. Your grade is C");
            }
            else if(marks >= 33){
                System.out.println("Congratulations! You have passed. Your grade is D");
            }
            else{
                System.out.println("Alas! You have failed.");
            }
        }
        else{
            System.out.println("Invalid Marks");
        }
    }
}
