package kashemjava;

import java.util.Scanner;

public class KashemJava{
    public static void main(String[] args) {
        Scanner kashem = new Scanner(System.in);
        System.out.println("Enter your age: ");
        int age = kashem.nextInt();
        
        if (age >= 18){
            if (age >= 60){
                System.out.println("You are a voter and eligible for senior citizen benefit");
            }
            else{
                System.out.println("You are a voter and not elligible for senior citizen benefit");
            }
        }
        else{
            System.out.println("You are not a voter");
        }
    }
}

