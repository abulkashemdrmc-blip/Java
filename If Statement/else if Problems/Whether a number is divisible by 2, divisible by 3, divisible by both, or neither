package kashemjava;

import java.util.Scanner;

public class KashemJava{
    public static void main(String[] args) {
        Scanner kashem = new Scanner(System.in);
        System.out.println("Enter your number: ");
        int number = kashem.nextInt();
        
        if (number % 2 == 0){
            if (number % 3 == 0){
                System.out.println("The number is divisible by both 2 and 3");
            }
            else{
                System.out.println("The number is divisible by 2 only");
            }
        }
        else{
            if (number % 3 == 0){
                System.out.println("The number is divisible by 3 only");
            }
            else{
                System.out.println("The number is neither divisible by 2 nor divisible by 3");
            }
        }
    }
}
