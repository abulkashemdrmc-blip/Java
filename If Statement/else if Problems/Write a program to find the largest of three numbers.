package kashemjava;

import java.util.Scanner;

public class KashemJava{
    public static void main(String[] args) {
        Scanner kashem = new Scanner(System.in);
        System.out.println("Enter your first number: ");
        int number1 = kashem.nextInt();
        System.out.println("Enter your second number: ");
        int number2 = kashem.nextInt();
        System.out.println("Enter your third number: ");
        int number3 = kashem.nextInt();
        
        if (number1 > number2){
            if (number1 > number3){
                System.out.println(number1 + " is the greatest");
            }
            else{
                System.out.println(number3 + " is the greatest");
            }
        }
        else{
            if (number2 > number3){
                System.out.println(number2 + " is the greatest");
            }
            else{
                System.out.println(number3 + " is the greatest");
            }
        }
    }
}
