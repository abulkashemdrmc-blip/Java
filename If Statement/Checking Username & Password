public class JavaApplication1 {

    public static void main(String[] args) {
        Scanner kashem = new Scanner(System.in);

        System.out.println("Enter your user name: ");
        String userName = kashem.nextLine();
        
        if(userName.equalsIgnoreCase("Java")){
            System.out.println("Enter your password: ");
            String password = kashem.nextLine();

            if(password.equals("Asdf1234")){
                String firstChar = userName.substring(0, 1);
                String lastChar = userName.substring(1);

                String name = firstChar.toUpperCase() + lastChar.toLowerCase();
                System.out.println("Welcome " + name);
            }
            else{
                System.out.println("Your password is incorrect");   
            }     
        }
        else{
            System.out.println("Incorrect Username");   
        }
    } 
}
