package NewArray;

public class NewArray {
    public static void main(String[] args) {
        int[] numbers = {55, 65, 75, 85, 95};
        int positive = 0;
        int negative = 0;
        int zero = 0;
        
        for(int item: numbers){
            if(item > 0){
                positive++;
            }
            else if(item < 0){
                negative++;
            }
            else{
                zero++;
            }
        }
        
        System.out.println("Total number of positive numbers are " + positive);
        System.out.println("Total number of negative numbers are " + negative);
        System.out.println("Total number of zeros are " + zero);
    }
}
