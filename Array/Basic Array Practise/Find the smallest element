package NewArray;

public class NewArray {
    public static void main(String[] args) {
        int[] numbers = {55, 65, 75, 85, 95};
        int min = numbers[0];
        
        for(int item: numbers){
            if(item < min){
                min = item;
            }
        }
        
        System.out.println(min);
    }
}
